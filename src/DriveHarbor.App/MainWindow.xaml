<Window x:Class="DriveHarbor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DriveHarbor" Icon="Assets/DriveHarbor.ico" Height="760" Width="1180" MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C8D5E3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1677FF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="22,12" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0F63D4" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AAB8C7" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FieldTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="TextField" TargetType="TextBox">
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SidebarBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="26,28,20,30">
                    <TextBlock Foreground="White" FontSize="25" FontWeight="SemiBold" Text="DriveHarbor" />
                    <TextBlock Margin="0,5,0,0" Foreground="#91A9C1" FontSize="12" Text="SSD → OneDrive" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowDashboardCommand}" Content="⌂  Dashboard" />
                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowSettingsCommand}" Content="⚙  Impostazioni" />
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="26,20">
                    <TextBlock Foreground="#8FA7BF" FontSize="11" Text="FUNZIONAMENTO LOCALE" />
                    <TextBlock Margin="0,5,0,0" Foreground="#C8D5E3" FontSize="12" Text="Nessuna telemetria" />
                    <TextBlock Margin="0,9,0,0" Foreground="#7891AA" FontSize="11" Text="{Binding ApplicationVersion}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="34,28,34,30">
            <Grid Visibility="{Binding DashboardVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="28" FontWeight="SemiBold" Text="Dashboard" />
                        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="Controlla lo stato e sincronizza in sicurezza." />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" Content="Annulla" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SynchronizeCommand}" Content="Sincronizza ora" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,26,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="STATO SSD" />
                            <TextBlock Margin="0,9,0,0" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" Text="{Binding SsdStatus}" />
                            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Text="{Binding SourcePath, TargetNullValue='Cartella non selezionata'}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="ONEDRIVE" />
                            <TextBlock Margin="0,9,0,0" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" Text="{Binding OneDriveStatus}" />
                            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Text="{Binding DestinationPath, TargetNullValue='Cartella non selezionata'}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="MODALITÀ" />
                            <TextBlock Margin="0,9,0,0" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" Text="{Binding Mode}" />
                            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding ModeSummary}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Margin="0,0,0,18" Padding="16" CornerRadius="8" Background="#1677FF"
                        Visibility="{Binding UpdateVisibility}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="16,0,0,0" Style="{StaticResource SecondaryButton}"
                                Command="{Binding OpenUpdateCommand}" Content="Apri download" />
                        <TextBlock VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" Text="{Binding UpdateMessage}" />
                    </DockPanel>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="STATO OPERAZIONE" />
                            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="17" FontWeight="SemiBold" Text="{Binding OperationStatus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="ULTIMA SINCRONIZZAZIONE" />
                            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding LastSynchronization}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="ULTIMO RISULTATO" />
                            <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" Text="{Binding LastResult}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Padding="18,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" Text="Log sincronizzazione" />
                        </Border>
                        <ListBox Grid.Row="1" ItemsSource="{Binding LogLines}" BorderThickness="0" Background="{DynamicResource LogBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                 Padding="12" FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer Visibility="{Binding SettingsVisibility}" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="28" FontWeight="SemiBold" Text="Impostazioni" />
                    <TextBlock Margin="0,6,0,24" Foreground="{DynamicResource SecondaryTextBrush}" Text="Scegli le cartelle e il comportamento della sincronizzazione." />
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Cartella sorgente sull'SSD" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource TextField}" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseSourceCommand}" Content="Sfoglia…" />
                            </Grid>
                            <TextBlock Margin="0,20,0,7" Style="{StaticResource FieldLabel}" Text="Cartella destinazione dentro OneDrive" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource TextField}" Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseDestinationCommand}" Content="Sfoglia…" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Modalità" />
                            <ComboBox Width="260" HorizontalAlignment="Left" Padding="10,8" ItemsSource="{Binding AvailableModes}" SelectedItem="{Binding Mode}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="14" Background="{DynamicResource BackupPanelBrush}" CornerRadius="7">
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource BackupTextBrush}" FontWeight="SemiBold" Text="Backup — consigliato" />
                                        <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource BackupTextBrush}" TextWrapping="Wrap"
                                                   Text="Copia i file nuovi e aggiornati dall’SSD. I file presenti soltanto su OneDrive rimangono al loro posto." />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Padding="14" Background="{DynamicResource MirrorPanelBrush}" CornerRadius="7">
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource MirrorTextBrush}" FontWeight="SemiBold" Text="Mirror — attenzione" />
                                        <TextBlock Margin="0,7,0,0" Foreground="{DynamicResource MirrorTextBrush}" TextWrapping="Wrap"
                                                   Text="Rende OneDrive identico all’SSD. I file presenti soltanto nella destinazione vengono eliminati dopo anteprima e conferma." />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Margin="0,11,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Text="DriveHarbor non elimina mai file dalla sorgente SSD. Usa Mirror solo se disponi di un’altra copia dei dati." />
                            <TextBlock Margin="0,20,0,7" Style="{StaticResource FieldLabel}" Text="Esclusioni (un pattern o una cartella per riga)" />
                            <TextBox MinHeight="110" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Style="{StaticResource TextField}"
                                     Text="{Binding ExclusionsText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Posizione dei log" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource TextField}" Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseLogDirectoryCommand}" Content="Sfoglia…" />
                            </Grid>
                            <TextBlock Margin="0,9,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Text="I log restano locali e vengono rimossi automaticamente secondo la retention." />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Aspetto" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Margin="0,0,22,0" Foreground="{DynamicResource PrimaryTextBrush}"
                                             Content="Sistema" IsChecked="{Binding UseSystemTheme}" GroupName="Theme" />
                                <RadioButton Margin="0,0,22,0" Foreground="{DynamicResource PrimaryTextBrush}"
                                             Content="Chiaro" IsChecked="{Binding UseLightTheme}" GroupName="Theme" />
                                <RadioButton Foreground="{DynamicResource PrimaryTextBrush}"
                                             Content="Scuro" IsChecked="{Binding UseDarkTheme}" GroupName="Theme" />
                            </StackPanel>
                            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Text="Sistema segue automaticamente il tema delle app configurato in Windows." />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Aggiornamenti" />
                            <ComboBox Width="260" HorizontalAlignment="Left" Padding="10,8"
                                      ItemsSource="{Binding AvailableUpdateChannels}" SelectedItem="{Binding UpdateChannel}" />
                            <TextBlock Margin="0,10,0,12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                       Text="Stabile ignora le versioni beta. Beta propone anche le anteprime pubblicate." />
                            <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CheckForUpdatesCommand}" Content="Controlla aggiornamenti" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Command="{Binding CancelSettingsCommand}" Content="Annulla modifiche" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" Content="Salva impostazioni" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
